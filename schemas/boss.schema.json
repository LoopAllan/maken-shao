{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maken Shao content record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "content",
    "gameVersion",
    "region",
    "sourceIds",
    "confidence",
    "verificationStatus",
    "verificationNote",
    "lastVerified",
    "isPlaceholder",
    "spoiler",
    "location"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "content": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20000
    },
    "gameVersion": {
      "type": "string",
      "enum": [
        "maken-x-dreamcast",
        "maken-shao-ps2",
        "both-confirmed"
      ]
    },
    "region": {
      "type": "string",
      "pattern": "^(unknown|[A-Z]{2})$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "official",
        "cross-verified",
        "single-source",
        "unverified"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified",
        "conflicting",
        "not-verified"
      ]
    },
    "verificationNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "isPlaceholder": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "spoiler": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    }
  }
}

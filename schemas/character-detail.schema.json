{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopallan.github.io/maken-shao/schemas/character-detail.schema.json",
  "title": "Maken Shao character detail record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sourceIds", "acquisition", "techniques", "techniqueSources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "acquisition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "method", "steps", "walkthroughIds", "sourceIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "method": { "type": "string", "minLength": 1, "maxLength": 500 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "walkthroughIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "techniques": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nameJa", "acquisitionRatePercent", "typeJa", "command", "media"],
        "properties": {
          "nameJa": { "type": "string", "minLength": 1, "maxLength": 120 },
          "acquisitionRatePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "typeJa": { "type": "string", "minLength": 1, "maxLength": 120 },
          "command": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
          "media": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "alt", "kind", "sourceId", "sourcePageUrl", "originalUrl", "archiveUrl", "archiveBytes", "sha256", "rightsNote"],
              "properties": {
                "path": { "type": "string", "pattern": "^assets/images/techniques/[a-z0-9][a-z0-9/-]+\\.(gif|jpg|jpeg|png|webp)$" },
                "alt": { "type": "string", "minLength": 1, "maxLength": 240 },
                "kind": { "type": "string", "enum": ["official-technique-action-frame", "timestamped-gameplay-frame", "timestamped-gameplay-gif"] },
                "sourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
                "sourcePageUrl": { "type": "string", "format": "uri", "maxLength": 500 },
                "originalUrl": { "type": "string", "format": "uri", "maxLength": 500 },
                "archiveUrl": { "type": "string", "format": "uri", "maxLength": 500 },
                "archiveBytes": { "type": "integer", "minimum": 1, "maximum": 100000000 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "rightsNote": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            }
          }
        }
      }
    },
    "techniqueSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "url", "accessedDate", "scope"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "type": "string", "format": "uri", "maxLength": 500 },
          "accessedDate": { "type": "string", "format": "date" },
          "scope": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  }
}

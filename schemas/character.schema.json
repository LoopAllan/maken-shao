{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maken Shao content record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "content",
    "gameVersion",
    "region",
    "sourceIds",
    "confidence",
    "verificationStatus",
    "verificationNote",
    "lastVerified",
    "isPlaceholder",
    "spoiler",
    "nameJa",
    "nameLatin",
    "nameZhHant",
    "nameEn",
    "nameEnStatus",
    "imagePath",
    "imageAlt",
    "role",
    "characterType",
    "affiliations",
    "brainJackStatus",
    "firstAppearanceWalkthroughId",
    "relatedWalkthroughIds",
    "spoilerLevel"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "content": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20000
    },
    "gameVersion": {
      "type": "string",
      "enum": [
        "maken-x-dreamcast",
        "maken-shao-ps2",
        "both-confirmed"
      ]
    },
    "region": {
      "type": "string",
      "pattern": "^(unknown|[A-Z]{2})$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "official",
        "cross-verified",
        "single-source",
        "unverified"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified",
        "conflicting",
        "not-verified"
      ]
    },
    "verificationNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "isPlaceholder": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "spoiler": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "nameJa": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameLatin": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    },
    "nameZhHant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameEn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameEnStatus": {
      "type": "string",
      "enum": [
        "official",
        "romanized"
      ]
    },
    "imagePath": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^assets/images/characters/[a-z0-9][a-z0-9-]{1,79}\\.(gif|jpg|jpeg|png|webp)$"
    },
    "imageAlt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 240
    },
    "characterType": {
      "type": "string",
      "enum": [
        "core",
        "brain-jack-host",
        "supporting",
        "faction-member",
        "unknown"
      ]
    },
    "affiliations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "brainJackStatus": {
      "type": "string",
      "enum": [
        "player-entity",
        "confirmed-host",
        "not-a-host",
        "not-verified"
      ]
    },
    "firstAppearanceWalkthroughId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "relatedWalkthroughIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "spoilerLevel": {
      "type": "string",
      "enum": [
        "none",
        "minor",
        "major"
      ]
    }
  }
}

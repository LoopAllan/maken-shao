{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maken Shao content record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "content",
    "gameVersion",
    "region",
    "sourceIds",
    "confidence",
    "verificationStatus",
    "verificationNote",
    "lastVerified",
    "isPlaceholder",
    "nameJa",
    "nameLatin",
    "nameZhHant",
    "nameEn",
    "nameEnStatus",
    "linkAliases",
    "imagePath",
    "imageAlt",
    "imageKind",
    "imageSourceId",
    "imageSha256",
    "imageOriginalUrl",
    "role",
    "characterType",
    "affiliations",
    "brainJackStatus",
    "firstAppearanceWalkthroughId",
    "relatedWalkthroughIds",
    "characterGroup",
    "wikiNavigationGroup",
    "wikiLinkedCharacterIds",
    "tags",
    "age",
    "occupation",
    "communityReferences",
    "imageFilePageUrl",
    "imageUploader",
    "imageSourceSha1",
    "imageRightsNote",
    "imageVersionNote",
    "imageUploadedAt",
    "imageDownloadUrl",
    "imageSourceMime",
    "imageSourceWidth",
    "imageSourceHeight",
    "imageSourceBytes",
    "imageSourceVerification",
    "imageLocalMime",
    "imageUnderlyingSource",
    "imageArtist",
    "imageLicense",
    "imageReuseStatus",
    "imageContentType"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "content": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20000
    },
    "gameVersion": {
      "type": "string",
      "enum": [
        "maken-x-dreamcast",
        "maken-shao-ps2",
        "both-confirmed"
      ]
    },
    "region": {
      "type": "string",
      "pattern": "^(unknown|[A-Z]{2})$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "official",
        "cross-verified",
        "single-source",
        "unverified"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified",
        "conflicting",
        "not-verified"
      ]
    },
    "verificationNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "isPlaceholder": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "nameJa": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameLatin": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    },
    "nameZhHant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameEn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameEnStatus": {
      "type": "string",
      "enum": [
        "official",
        "romanized",
        "community"
      ]
    },
    "linkAliases": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "imagePath": {
      "type": "string",
      "pattern": "^assets/images/characters/[a-z0-9][a-z0-9-]{1,79}\\.(gif|jpg|jpeg|png|webp|svg)$"
    },
    "imageAlt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "characterType": {
      "type": "string",
      "enum": [
        "core",
        "brain-jack-host",
        "supporting",
        "faction-member",
        "unknown"
      ]
    },
    "affiliations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "brainJackStatus": {
      "type": "string",
      "enum": [
        "player-entity",
        "confirmed-host",
        "not-a-host",
        "not-verified"
      ]
    },
    "firstAppearanceWalkthroughId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "relatedWalkthroughIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "imageKind": {
      "type": "string",
      "enum": [
        "official-source",
        "community-source-game-capture",
        "community-source-artwork",
        "community-source-card",
        "no-attributable-source"
      ]
    },
    "imageSourceId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "imageOriginalUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://(web\\.archive\\.org/web/[0-9]{14}im_/http://www\\.atlus\\.co\\.jp/cs/game/pstation2/shao/chara_images/[A-Za-z0-9_.-]+|static\\.wikia\\.nocookie\\.net/megamitensei/images/.+)$"
    },
    "imageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "characterGroup": {
      "type": "string",
      "enum": [
        "main",
        "fukenshi",
        "hakke",
        "hostile",
        "npc",
        "other"
      ]
    },
    "wikiNavigationGroup": {
      "type": "string",
      "enum": [
        "playable",
        "non-playable"
      ]
    },
    "wikiLinkedCharacterIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "age": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 99999
    },
    "occupation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 240
    },
    "communityReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "pageTitle",
          "pageUrl",
          "revisionId",
          "revisionTimestamp",
          "accessedDate",
          "note"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
          },
          "pageTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "pageUrl": {
            "type": "string",
            "pattern": "^https://megamitensei\\.fandom\\.com/wiki/.+$"
          },
          "revisionId": {
            "type": "integer",
            "minimum": 1
          },
          "revisionTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "accessedDate": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        }
      }
    },
    "imageFilePageUrl": {
      "type": "string",
      "pattern": "^https://megamitensei\\.fandom\\.com/wiki/File:.+$"
    },
    "imageUploader": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "imageSourceSha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "imageRightsNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "imageVersionNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "imageUploadedAt": {
      "type": "string",
      "format": "date-time"
    },
    "imageDownloadUrl": {
      "type": "string",
      "pattern": "^https://static\\.wikia\\.nocookie\\.net/megamitensei/images/.+/revision/latest(?:/scale-to-width-down/640)?\\?cb=[0-9]+$"
    },
    "imageSourceMime": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg"
      ]
    },
    "imageSourceWidth": {
      "type": "integer",
      "minimum": 1
    },
    "imageSourceHeight": {
      "type": "integer",
      "minimum": 1
    },
    "imageSourceBytes": {
      "type": "integer",
      "minimum": 1
    },
    "imageSourceVerification": {
      "type": "string",
      "enum": [
        "exact-retrieval-verified",
        "api-metadata-only-current-cdn-byte-mismatch"
      ]
    },
    "imageLocalMime": {
      "type": "string",
      "const": "image/webp"
    },
    "imageUnderlyingSource": {
      "type": "string",
      "const": "unknown"
    },
    "imageArtist": {
      "type": "string",
      "const": "unknown"
    },
    "imageLicense": {
      "type": "string",
      "const": "not-supplied"
    },
    "imageReuseStatus": {
      "type": "string",
      "const": "copyrighted-reference-use-only-no-redistribution-license-claimed"
    },
    "imageContentType": {
      "type": "string",
      "enum": [
        "game-screenshot",
        "game-card",
        "character-artwork"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maken Shao content record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "content",
    "gameVersion",
    "region",
    "sourceIds",
    "confidence",
    "verificationStatus",
    "verificationNote",
    "lastVerified",
    "isPlaceholder",
    "endingType",
    "triggerFlow",
    "narrativeContext",
    "terminalWalkthroughId",
    "entryWalkthroughIds",
    "entryMode",
    "finalOpponentCharacterId",
    "communityOutcomeLabels",
    "canonicalNameStatus",
    "narrativeEvidenceStatus",
    "unsupportedDetails",
    "conditionSummary",
    "conditionEvidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "content": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20000
    },
    "gameVersion": {
      "type": "string",
      "enum": [
        "maken-x-dreamcast",
        "maken-shao-ps2",
        "both-confirmed"
      ]
    },
    "region": {
      "type": "string",
      "pattern": "^(unknown|[A-Z]{2})$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "official",
        "cross-verified",
        "single-source",
        "unverified"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified",
        "conflicting",
        "not-verified"
      ]
    },
    "verificationNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "isPlaceholder": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "endingType": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "triggerFlow": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 1000 }
    },
    "narrativeContext": {
      "type": "string",
      "minLength": 3,
      "maxLength": 5000
    },
    "terminalWalkthroughId": { "type": "string", "pattern": "^route-[a-z0-9-]+$" },
    "entryWalkthroughIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^route-[a-z0-9-]+$" }
    },
    "entryMode": { "type": "string", "enum": ["all-of", "any-of", "conditional"] },
    "finalOpponentCharacterId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
    "communityOutcomeLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 120 }
    },
    "canonicalNameStatus": { "type": "string", "enum": ["community-label", "official-name", "unknown"] },
    "narrativeEvidenceStatus": { "type": "string", "enum": ["route-only", "source-described", "unverified"] },
    "unsupportedDetails": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 1000 }
    },
    "conditionSummary": { "type": "string", "minLength": 3, "maxLength": 3000 },
    "conditionEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "locator", "scope", "verified"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
          "locator": { "type": "string", "minLength": 3, "maxLength": 500 },
          "scope": { "type": "string", "minLength": 3, "maxLength": 500 },
          "verified": { "type": "boolean" }
        }
      }
    }
  }
}

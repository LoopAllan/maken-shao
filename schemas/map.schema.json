{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maken Shao map record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "nameZhHant",
    "nameJa",
    "nameEn",
    "nameEnStatus",
    "linkAliases",
    "summary",
    "story",
    "structure",
    "sequence",
    "mapType",
    "isMainMap",
    "gameVersion",
    "region",
    "sourceIds",
    "confidence",
    "verificationStatus",
    "lastVerified",
    "walkthroughIds",
    "requiredMapIds",
    "anyOfRequiredMapIds",
    "unlockNote",
    "obtainableCharacterIds",
    "enemies",
    "images"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240
    },
    "nameZhHant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "nameJa": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "nameEn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nameEnStatus": {
      "type": "string",
      "enum": [
        "official-localized",
        "geographic-or-romanized"
      ]
    },
    "linkAliases": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "story": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4000
    },
    "structure": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4000
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "mapType": {
      "type": "string",
      "enum": [
        "main",
        "optional",
        "ending"
      ]
    },
    "isMainMap": {
      "type": "boolean"
    },
    "gameVersion": {
      "type": "string",
      "const": "maken-shao-ps2"
    },
    "region": {
      "type": "string",
      "const": "JP"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "official",
        "cross-verified",
        "single-source"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified"
      ]
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "walkthroughIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "requiredMapIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "anyOfRequiredMapIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "unlockNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "obtainableCharacterIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nameZhHant",
          "nameJa",
          "nameEn",
          "type",
          "sourceIds"
        ],
        "properties": {
          "nameZhHant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "nameJa": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "nameEn": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "standard-enemy",
              "boss",
              "brain-jack-target",
              "hazard"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "alt",
          "kind",
          "sourceId",
          "sourcePageUrl",
          "mapPageRevisionId",
          "fileTitle",
          "filePageUrl",
          "fileRevisionId",
          "originalUrl",
          "derivativeUrl",
          "mime",
          "width",
          "height",
          "bytes",
          "sha256",
          "sourceMime",
          "sourceWidth",
          "sourceHeight",
          "sourceBytes",
          "sourceSha1",
          "sourceUploader",
          "sourceUploadedAt",
          "gameVersionScope",
          "associationNote",
          "rightsNote"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/images/maps/[a-z0-9][a-z0-9._/-]+\\.(?:jpg|jpeg|png|webp)$"
          },
          "alt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "enum": [
              "globe-marker",
              "map-structure",
              "landmark-gameplay"
            ]
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
          },
          "sourcePageUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "pattern": "^https://megamitensei[.]fandom[.]com/wiki/"
          },
          "originalUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "pattern": "^https://static[.]wikia[.]nocookie[.]net/megamitensei/images/"
          },
          "mime": {
            "type": "string",
            "const": "image/webp"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "gameVersionScope": {
            "type": "string",
            "const": "maken-x-dreamcast"
          },
          "associationNote": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1500
          },
          "rightsNote": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1500
          },
          "mapPageRevisionId": {
            "type": "integer",
            "minimum": 1
          },
          "fileTitle": {
            "type": "string",
            "pattern": "^File:Maken X .+",
            "maxLength": 240
          },
          "filePageUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "pattern": "^https://megamitensei[.]fandom[.]com/wiki/File:Maken_X_"
          },
          "fileRevisionId": {
            "type": "integer",
            "minimum": 1
          },
          "sourceMime": {
            "type": "string",
            "const": "image/png"
          },
          "sourceWidth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "sourceHeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "sourceBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "sourceSha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "sourceUploader": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceUploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "derivativeUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://static[.]wikia[.]nocookie[.]net/megamitensei/images/",
            "maxLength": 500
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maken Shao content record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "content",
    "gameVersion",
    "region",
    "sourceIds",
    "confidence",
    "verificationStatus",
    "verificationNote",
    "lastVerified",
    "isPlaceholder",
    "sequence",
    "area",
    "routeId",
    "routeTitle",
    "objectives",
    "prerequisites",
    "anyOfPrerequisites",
    "branchChoiceIds",
    "bossIds",
    "brainJackTargetIds",
    "missable"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "content": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20000
    },
    "gameVersion": {
      "type": "string",
      "enum": [
        "maken-x-dreamcast",
        "maken-shao-ps2",
        "both-confirmed"
      ]
    },
    "region": {
      "type": "string",
      "pattern": "^(unknown|[A-Z]{2})$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "official",
        "cross-verified",
        "single-source",
        "unverified"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "partially-verified",
        "conflicting",
        "not-verified"
      ]
    },
    "verificationNote": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    },
    "isPlaceholder": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "area": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "routeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "routeTitle": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "anyOfPrerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "branchChoiceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "bossIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "brainJackTargetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "missable": {
      "type": "boolean"
    }
  }
}
